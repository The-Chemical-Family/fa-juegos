{
  "name": "fa-juegos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "juegos/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "check": "node tools/verificar-juegos.mjs && npm run check --workspaces --if-present",
    "build": "node tools/ensamblar.mjs",
    "dev": "npm run dev -w apps/contenedor",
    "preview": "npm run preview -w apps/contenedor",
    "dev:todo": "node tools/dev-todo.mjs"
  }
}
